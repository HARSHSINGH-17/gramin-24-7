{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pahaadcare.example/schemas/rpm-alert.schema.json",
  "title": "PahaadCare RPM Alert",
  "description": "Version 1.0 contract for abnormal, missing, stale, or ingestion alerts. Demonstration contract; not clinical guidance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "alert_id",
    "patient_id",
    "category",
    "severity",
    "reason",
    "created_at",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "alert_id": { "type": "string", "format": "uuid" },
    "patient_id": {
      "type": "string",
      "pattern": "^PC-[A-Z0-9]{4,32}$"
    },
    "related_event_id": { "type": "string", "format": "uuid" },
    "category": {
      "type": "string",
      "enum": [
        "abnormal_measurement",
        "missing_measurement",
        "stale_reading",
        "ingestion_failure"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "rule_version"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "rule_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "expected_measurement_type": {
          "type": "string",
          "enum": [
            "heart_rate",
            "oxygen_saturation",
            "body_temperature",
            "systolic_blood_pressure",
            "diastolic_blood_pressure"
          ]
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["open", "acknowledged", "resolved"]
    },
    "acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acknowledged_at", "acknowledged_by"],
      "properties": {
        "acknowledged_at": { "type": "string", "format": "date-time" },
        "acknowledged_by": { "type": "string", "minLength": 1, "maxLength": 128 },
        "note": { "type": "string", "maxLength": 2000 }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolved_at", "resolved_by", "resolution_code"],
      "properties": {
        "resolved_at": { "type": "string", "format": "date-time" },
        "resolved_by": { "type": "string", "minLength": 1, "maxLength": 128 },
        "resolution_code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "note": { "type": "string", "maxLength": 2000 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "category": { "const": "abnormal_measurement" } },
        "required": ["category"]
      },
      "then": { "required": ["related_event_id"] }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["acknowledged", "resolved"] } },
        "required": ["status"]
      },
      "then": { "required": ["acknowledgement"] }
    },
    {
      "if": {
        "properties": { "status": { "const": "resolved" } },
        "required": ["status"]
      },
      "then": { "required": ["resolution"] }
    }
  ]
}
