# Production Backend Environment Configuration (Render / Railway / Fly.io / VPS)

PAHAADCARE_ENV=production
PORT=8000

# PostgreSQL Connection String (Supabase / Neon / Render Postgres / AWS RDS)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://pahaadcare_user:your_secure_password@dpg-xxxx.render.com:5432/pahaadcare_prod?sslmode=require

# Secure JWT signing secret (minimum 32 characters)
PAHAADCARE_AUTH_SECRET=generate-a-secure-random-64-character-production-secret-here

# Token lifespan in minutes (1440 min = 24 hours)
PAHAADCARE_TOKEN_MINUTES=1440

# Administrative provisioning key for onboarding initial clinician accounts (min 16 chars)
PAHAADCARE_PROVISIONING_SECRET=generate-a-secure-random-32-character-provisioning-key

# Demo accounts are strictly prohibited in production
PAHAADCARE_DEMO_ENABLED=false

# Allowed Frontend Origins (explicit origins only in production, comma-separated)
PAHAADCARE_CORS_ORIGINS=https://pahaadcare.vercel.app,https://pahaadcare.netlify.app

# Max JSON body size (bytes)
PAHAADCARE_MAX_BODY_BYTES=1048576

# Clinical Escalation Worker
ESCALATION_WORKER_ENABLED=true
ESCALATION_POLL_INTERVAL_SECONDS=15.0
