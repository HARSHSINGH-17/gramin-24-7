# Local development placeholders only. Do not commit real secrets.
PAHAADCARE_ENV=development
PAHAADCARE_AUTH_SECRET=replace-with-a-random-32-character-secret
PAHAADCARE_DEMO_ENABLED=true
PAHAADCARE_DEMO_USERNAME=clinician-demo
PAHAADCARE_DEMO_PASSWORD_HASH=generate-with-backend-auth-tool
PAHAADCARE_DEMO_ROLE=clinician
PAHAADCARE_TOKEN_MINUTES=30
PAHAADCARE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
PAHAADCARE_MAX_BODY_BYTES=65536
PAHAADCARE_DB_PATH=backend/data/pahaadcare.sqlite3
